# Copy to .env and fill in. NEVER commit .env.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Comma separated USD-M perpetual symbols to scan
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,UNIUSDT,XAUTUSDT

# Scanner
SCAN_INTERVAL_MS=60000
A_PLUS_THRESHOLD=88
SIGNAL_COOLDOWN_MS=28800000

# Set to true to log alerts instead of sending to Telegram
DRY_RUN=false

# Prop-account risk mode (strict filters, position sizing, loss guards)
PROP_MODE=true
ACCOUNT_BALANCE=5000
RISK_PER_TRADE_PCT=0.2
MAX_RISK_USD=25
MAX_TRADES_PER_DAY=2
MAX_OPEN_TRADES=1
DAILY_LOSS_LIMIT_USD=250
TOTAL_LOSS_LIMIT_USD=500
DAILY_STOP_USD=150
TOTAL_STOP_USD=350
# Contract size per symbol. 1 = 1 coin per lot. VERIFY with FundingPips specs.
CONTRACT_SIZES=BTCUSDT:1,ETHUSDT:1,SOLUSDT:1,UNIUSDT:1,XAUTUSDT:1
LOT_STEP=0.01
MIN_RR=2.5
MIN_ADX=20
SESSION_FILTER=true
MIN_ATR_PCT=0.15
MAX_ATR_PCT=1.5
MAX_SPREAD_PCT=0.05
REQUIRE_SWEEP=true
REQUIRE_DISPLACEMENT=true
REQUIRE_LIQUIDITY_TARGET=true
STRICT_HTF=true

# Optional: persistent state for Render (Upstash Redis REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STATE_KEY=kronos-apex-state

# Optional: protects /api/test-telegram and /api/config
ADMIN_KEY=
PORT=3000
